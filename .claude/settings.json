{
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(bin/rails:*)",
      "Bash(bundle exec:*)",
      "Bash(bundle install:*)",
      "Bash(cat:*)",
      "Bash(claude mcp:*)",
      "Bash(command -v:*)",
      "Bash(cp:*)",
      "Bash(diff:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git pull:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git worktree:*)",
      "Bash(gws --help)",
      "Bash(gws auth:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(lsof:*)",
      "Bash(mkdir:*)",
      "Bash(mise exec:*)",
      "Bash(mise which:*)",
      "Bash(mv:*)",
      "Bash(rtk bundle install:*)",
      "Bash(rtk diff:*)",
      "Bash(rtk find:*)",
      "Bash(rtk git add:*)",
      "Bash(rtk git branch:*)",
      "Bash(rtk git checkout:*)",
      "Bash(rtk git commit:*)",
      "Bash(rtk git diff:*)",
      "Bash(rtk git fetch:*)",
      "Bash(rtk git log:*)",
      "Bash(rtk git pull:*)",
      "Bash(rtk git show:*)",
      "Bash(rtk git stash:*)",
      "Bash(rtk git status:*)",
      "Bash(rtk git worktree:*)",
      "Bash(rtk grep:*)",
      "Bash(rtk ls:*)",
      "Bash(rtk mise exec:*)",
      "Bash(rtk rake test:*)",
      "Bash(rtk read:*)",
      "Bash(rtk rspec:*)",
      "Bash(rtk rubocop:*)",
      "Bash(rtk wc:*)",
      "Bash(tail:*)",
      "Bash(test:*)",
      "Bash(touch:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(xargs dirname:*)",
      "Bash(yarn test:*)",
      "WebFetch(domain:developer.atlassian.com)",
      "WebFetch(domain:docs.livekit.io)",
      "WebSearch"
    ],
    "deny": [],
    "ask": [
      "Bash(rm:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [],
  "disabledMcpjsonServers": [],
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$(uname)\" = \"Darwin\" ]; then afplay /System/Library/Sounds/Glass.aiff; else paplay /usr/share/sounds/freedesktop/stereo/complete.oga; fi",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$(dirname \"$(readlink -f \"$HOME/.claude/settings.json\")\")/scripts/toolkit-sync\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/scripts/rtk-rewrite.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "claudit@quickstop": true,
    "ruby-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "codebase-readiness@dgalarza-workflows": true,
    "code-simplifier@claude-plugins-official": true,
    "evals-skills@hamelsmu-evals-skills": true,
    "cc-plugin-you-should-know@builtin": true
  },
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "dgalarza-workflows": {
      "source": {
        "source": "github",
        "repo": "dgalarza/claude-code-workflows"
      }
    },
    "hamelsmu-evals-skills": {
      "source": {
        "source": "github",
        "repo": "hamelsmu/evals-skills"
      }
    }
  },
  "outputStyle": "Concise",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowLocalBinding": true
    },
    "excludedCommands": [
      "bin/ci",
      "bin/rails *",
      "bin/rspec *",
      "mise exec -- rails *",
      "mise exec -- rspec *",
      "psql *"
    ]
  },
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": []
  }
}
