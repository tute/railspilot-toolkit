#!/usr/bin/env sh
set -eu

TOOLKIT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

case "$(uname -s)" in
  Darwin) CURSOR_USER_DIR="$HOME/Library/Application Support/Cursor/User" ;;
  Linux)  CURSOR_USER_DIR="$HOME/.config/Cursor/User" ;;
esac


cd ~/.cursor
ln -sfn "$TOOLKIT_ROOT/.cursor/settings.json" "$CURSOR_USER_DIR/settings.json"
ln -sfn "$TOOLKIT_ROOT/.cursor/rules" rules
ln -sfn "$TOOLKIT_ROOT/.cursor/worktrees.json" worktrees.json

mkdir -p ~/.config/git
ln -sfn "$TOOLKIT_ROOT/git/ignore" ~/.config/git/ignore

cd ~/.claude
ln -sfn "$TOOLKIT_ROOT/.claude/CLAUDE.md" CLAUDE.md
ln -sfn "$TOOLKIT_ROOT/.claude/agents" agents
ln -sfn "$TOOLKIT_ROOT/.claude/commands" commands
ln -sfn "$TOOLKIT_ROOT/.claude/rules" rules
ln -sfn "$TOOLKIT_ROOT/.claude/scripts" scripts
ln -sfn "$TOOLKIT_ROOT/.claude/settings.json" settings.json
ln -sfn "$TOOLKIT_ROOT/.claude/statusline.sh" statusline.sh

mkdir -p skills
if [ "$(cd skills && pwd -P)" != "$(cd "$TOOLKIT_ROOT/.claude/skills" && pwd -P)" ]; then
  for skill in "$TOOLKIT_ROOT"/.claude/skills/*; do
    name="$(basename "$skill")"
    ln -sfn "$skill" "skills/$name"
    [ -d "skills/$name" ] || echo "warning: skills/$name does not resolve" >&2
  done
fi

for skill in "$HOME"/.agents/skills/*; do
  name="$(basename "$skill")"
  [ -d "$skill" ] && [ ! -e "skills/$name" ] && ln -s "$skill" "skills/$name"
done

if [ -n "${1:-}" ]; then
  cd "$1"
  ln -sfn "$TOOLKIT_ROOT/conductor.json" conductor.json
  if git rev-parse --git-common-dir >/dev/null 2>&1; then
    hooks="$(git rev-parse --path-format=absolute --git-common-dir)/hooks"
    target="$TOOLKIT_ROOT/.claude/scripts/pre-commit-checks"
    hooks_path=$(git config --get core.hooksPath || true)
    current=$(readlink "$hooks/pre-commit" 2>/dev/null || true)
    if [ -n "$hooks_path" ]; then
      echo "warning: core.hooksPath set in $(pwd), pre-commit not linked" >&2
    elif { [ -e "$hooks/pre-commit" ] || [ -L "$hooks/pre-commit" ]; } && [ "$current" != "$target" ]; then
      echo "warning: $hooks/pre-commit exists, not overwritten" >&2
    else
      mkdir -p "$hooks"
      ln -sfn "$target" "$hooks/pre-commit"
    fi
  else
    echo "warning: $(pwd) is not a git repo, pre-commit not linked" >&2
  fi
fi
